{
  "name": "@ds/react",
  "version": "0.1.0",
  "description": "AIR-DS React components: react-aria-components base, token-only CSS Modules, docgen-fed machine registries.",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/index.ts",
    "./dist/index.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo '@ds/react lint: no-op placeholder (token-value lint lives in @ds/validate)'",
    "test": "vitest run",
    "build": "vite build",
    "generate": "tsx scripts/generate.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ds/tokens": "workspace:*",
    "react-aria-components": "^1.20.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "^10.5.7",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  }
}
