  "typeface": {
    "$type": "fontFamily",
    "sans": { "$value": "'Inter Test', system-ui, sans-serif" },
    "mono": { "$value": "'JetBrains Mono Test', ui-monospace, monospace" }
  },
  "type-scale": {
    "$type": "number",
    "base": { "$value": 15 },
    "ratio": { "$value": 1.2 }
  },
  "radius-scale": {
    "$type": "number",
    "1": { "$value": 3 },
    "2": { "$value": 6 },
    "3": { "$value": 10 },
    "4": { "$value": 14 },
    "full": { "$value": 9999 }
  },
  "space-base": { "$value": 5, "$type": "number" },
  "elevation": {
    "$type": "shadow",
    "1": { "$value": "0 1px 2px 0 rgb(3 7 18 / 0.08)" },
    "2": { "$value": "0 4px 8px -2px rgb(3 7 18 / 0.12)" },
    "3": { "$value": "0 12px 20px -4px rgb(3 7 18 / 0.14)" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "100ms" },
      "normal": { "$value": "180ms" },
      "slow": { "$value": "300ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": "cubic-bezier(0.25, 0, 0, 1)" },
      "enter": { "$value": "cubic-bezier(0, 0, 0.25, 1)" },
      "exit": { "$value": "cubic-bezier(0.45, 0, 1, 1)" }
    }
  }
}
